PORT=3000
NODE_ENV=development
LOCAL_TEST_MODE=true
HOST=127.0.0.1

DB_PASSWORD=db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mygroomer_dev
DB_USER=root
DATABASE_URL=postgresql://postgres:password@localhost:5432/mygroomer_dev

# Nome público. O aplicativo usa EXPO_PUBLIC_APP_NAME e EXPO_PUBLIC_APP_SCHEME com os mesmos padrões.
APP_NAME=Tio de Pet
APP_SCHEME=tiodepet
APP_REFERENCE_PREFIX=tiodepet
# Sem PAYMENT_CALLBACK_URL, o callback usa CLIENT_URL/payment/callback.

JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:8081
RESEND_TEST_EMAIL=

RESEND_API_KEY=api_key_...

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Geocoding API da Geoapify. Sem esta chave, gravar o endereço-base responde 503.
GEOAPIFY_API_KEY=

PAYSTACK_SECRET_KEY =

RABBITMQ_URL=amqp://guest:guest@localhost:5672

REDIS_URL=redis://localhost:6379
